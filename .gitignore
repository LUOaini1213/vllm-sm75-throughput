# `python -m compileall -q .` is the first CI step, and it is also what anyone
# reproducing the checks locally runs first. Without this, that step leaves six
# untracked .pyc files behind and the next `git add -A` commits them.
__pycache__/
*.py[cod]

# Notebook checkpoints, for the same reason: the repro path opens the notebooks.
.ipynb_checkpoints/

# Local virtualenv and the run-time outputs of the revised clients (not results).
.venv/
sweep_results_v2.json
prefix_results_v2.json
isolate_results_v2.json
