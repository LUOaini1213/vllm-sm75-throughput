# Evidence hashes are over recorded Git bytes. Do not convert checkout line endings.
* -text
# A terminating blank line is part of a complete SSE frame, including at EOF.
tests/fixtures/*.sse whitespace=-blank-at-eof
# results_local/ 里那份 JSON 是原样收录的原始产物，它的 sha256 记在
# results_local/README.md 里、并由 check_claims.py 在 CI 里核。
# 不能让 checkout 改行尾，否则校验和对不上。
results_local/*.json -text
